<?xml version="1.0" encoding="utf-8"?>
<!--
  asInvoker, deliberately. The Phase 4 design elevates only for the unlocker, so that zip extraction
  never runs as administrator. Upstream's manifest requests requireAdministrator for the whole
  application; copying it here would silently remove the elevation precondition's reason to exist.

  Note this file changes nothing about the current artifact: the SDK's default manifest already
  yields asInvoker. It exists so the requirement is visible in the source tree rather than resting on
  a default. The release workflow greps the built exe for the asInvoker directive and against the
  requireAdministrator one, so the check is on what actually ships, not on this file.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="2.0.0.0" name="LamSims.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share this ID; there is no separate Windows 11 entry, despite
           upstream's manifest listing a second invented GUID. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
